{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about registered GameForge users",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "User generated games, web apps, and platforms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["app", "website", "platform", "game"] },
        "description": { "type": "string", "maxLength": 1000 },
        "code": { "type": "string" },
        "features": { "type": "array" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "type", "code"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection storing user profiles"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection storing user generated projects"
    }
  }
}
