rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'digitalimport655775457@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // User profiles: allow reading so admin can display all registered creators
    match /users/{userId} {
      allow read, get, list: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // Projects collection: allow reading public creations and listing by owner/admin
    match /projects/{projectId} {
      allow read, get, list: if true;
      allow create, update: if isValidId(projectId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}


